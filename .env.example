# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat API works. Pick one block.

# Local development with Ollama (the default when nothing is set):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# Public demo with Groq (key from console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<a Groq model name>
# LLM_API_KEY=<your Groq key>
