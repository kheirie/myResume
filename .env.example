# Copy to .env if you want to change these defaults. Never commit .env.
# Keys do not go here: put them in raw/secrets.env (git-ignored), e.g.
#   GROQ_API_KEY=...
#   OPENROUTER_API_KEY=...
#   HF_TOKEN=...

# Provider per run with --provider, or a default here: ollama | groq | openrouter | huggingface | chain
LLM_PROVIDER=ollama

# Order for --provider chain. Providers without a key are skipped.
LLM_FALLBACK_ORDER=groq,openrouter,huggingface,ollama

OLLAMA_MODEL=llama3.1:8b
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
HF_MODEL=openai/gpt-oss-120b
